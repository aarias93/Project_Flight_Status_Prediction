      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Retrasos observados vs. riesgo estimado por mes",
          "description": "Comparación mensual entre la tasa real de retrasos ≥15 minutos y el promedio de probabilidades del modelo. Los indicadores se ponderan por número de vuelos. Las probabilidades no están calibradas; el modelo se utiliza para priorizar vuelos por riesgo.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "spec": {
                        "dataset": "vuelos_analytics",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    TO_CHAR(fecha, 'YYYY-MM') AS \"Mes\",\n    100.0 * SUM(retrasos_observados)\n        / NULLIF(SUM(vuelos_con_resultado), 0)\n        AS \"Retrasos observados\",\n    100.0 * SUM(suma_probabilidades)\n        / NULLIF(SUM(vuelos), 0)\n        AS \"Riesgo medio estimado\"\nFROM analitica.resumen_vuelos\nWHERE modelo_version = 'boosting_v2_1m'\n  AND fecha BETWEEN DATE '2022-01-01' AND DATE '2022-07-31'\n  AND aerolinea IN (${aerolinea:sqlstring})\nGROUP BY TO_CHAR(fecha, 'YYYY-MM')\nORDER BY \"Mes\";",
