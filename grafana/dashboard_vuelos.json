      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Orígenes con mayor tasa de retrasos · mínimo 10.000 vuelos",
          "description": "Comparación de vuelos analizados y retrasos a la llegada por aeropuerto\nde origen, enero–julio de 2022. Se incluyen orígenes con al menos\n10.000 vuelos con resultado conocido para evitar rankings dominados\npor operaciones de muy bajo volumen. Este umbral es un criterio\nde presentación, no una garantía estadística.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "spec": {
                        "dataset": "vuelos_analytics",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    aeropuerto_origen AS \"Origen\",\n    SUM(vuelos) AS \"Vuelos analizados\",\n    SUM(retrasos_observados) AS \"Vuelos con retraso\",\n    ROUND(\n        100.0 * SUM(retrasos_observados)\n        / NULLIF(SUM(vuelos_con_resultado), 0),\n        2\n    ) AS \"Retrasos (%)\"\nFROM analitica.resumen_vuelos\nWHERE modelo_version = 'boosting_v2_1m'\n  AND fecha BETWEEN DATE '2022-01-01' AND DATE '2022-07-31'\n  AND aerolinea IN (${aerolinea:sqlstring})\nGROUP BY aeropuerto_origen\nHAVING SUM(vuelos_con_resultado) >= 10000\nORDER BY \"Retrasos (%)\" DESC, \"Vuelos analizados\" DESC\nLIMIT 15;",
                        "sql": {
