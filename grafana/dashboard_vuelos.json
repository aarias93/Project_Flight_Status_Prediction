      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Valor del modelo · evaluación global 2022",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
