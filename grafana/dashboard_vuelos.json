                        "rawQuery": true,
                        "rawSql": "SELECT\n    aeropuerto_origen AS \"Aeropuerto de origen\",\n    SUM(retrasos_observados) AS \"Vuelos con retraso\"\nFROM analitica.resumen_vuelos\nWHERE modelo_version = 'boosting_v2_1m'\n  AND fecha BETWEEN DATE '2022-01-01' AND DATE '2022-07-31'\n  AND aerolinea IN (${aerolinea:sqlstring})\nGROUP BY aeropuerto_origen\nORDER BY SUM(retrasos_observados) DESC, aeropuerto_origen\nLIMIT 10;",
